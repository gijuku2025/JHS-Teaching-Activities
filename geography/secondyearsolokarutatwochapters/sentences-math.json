  "chapters": [
    {
      "id": "ch2-1",
      "title": "Chapter 2-1: Parallel Lines",
      "sentences": [
        {
          "part1": "Parallel lines stay",
          "part2": "the same distance apart.",
          "audio": "parallel_lines_stay.mp3"
        },
        {
          "part1": "A transversal is a line",
          "part2": "that crosses two lines.",
          "audio": "a_transversal_is_a_line.mp3"
        },
        {
          "part1": "If two lines are parallel, corresponding angles",
          "part2": "are equal.",
          "audio": "if_two_lines_are_parallel_corr.mp3"
        },
        {
          "part1": "If two lines are parallel, alternate interior angles",
          "part2": "are equal.",
          "audio": "if_two_lines_are_parallel_alte.mp3"
        },
        {
          "part1": "Corresponding angles",
          "part2": "are in the same position.",
          "audio": "corresponding_angles.mp3"
        },
        {
          "part1": "Alternate interior angles are inside the parallel lines and on",
          "part2": "opposite sides of the transversal.",
          "audio": "alternate_interior_angles_are_.mp3"
        },
        {
          "part1": "If corresponding angles are equal,",
          "part2": "the two lines are parallel.",
          "audio": "if_corresponding_angles_are_eq.mp3"
        },
        {
          "part1": "Vertical angles",
          "part2": "are equal.",
          "audio": "vertical_angles.mp3"
        }
      ]
    },
    {
      "id": "ch2-9",
      "title": "Chapter 2-9: Congruent Figures",
      "sentences": [
        {
          "part1": "Two figures are congruent when one can be moved",
          "part2": "so that it fits exactly on the other figure.",
          "audio": "two_figures_are_congruent_when_one_can_be_moved.mp3"
        },
        {
          "part1": "Matching vertices, sides, and angles are called",
          "part2": "corresponding vertices, sides, and angles.",
          "audio": "matching_vertices_sides_and_angles_are_called.mp3"
        },
        {
          "part1": "A triangle is determined when",
          "part2": "the lengths of its three sides are given.",
          "audio": "a_triangle_is_determined_when.mp3"
        },
        {
          "part1": "A triangle is determined when the lengths of two sides",
          "part2": "and the angle between them are given.",
          "audio": "a_triangle_is_determined_when_the_lengths_of_two_sides.mp3"
        },
        {
          "part1": "A triangle is determined when the length of one side",
          "part2": "and the two angles at its ends are given.",
          "audio": "a_triangle_is_determined_when_the_length_of_one_side.mp3"
        },
        {
          "part1": "Two triangles are congruent when three pairs of corresponding sides",
          "part2": "are equal.",
          "audio": "two_triangles_are_congruent_when_three_pairs_of_corresponding_sides.mp3"
        },
        {
          "part1": "Two triangles are congruent when two pairs of corresponding sides",
          "part2": "and the angle between them are equal.",
          "audio": "two_triangles_are_congruent_when_two_pairs_of_corresponding_sides.mp3"
        },
        {
          "part1": "Two triangles are congruent when one pair of corresponding sides",
          "part2": "and the two angles at its ends are equal.",
          "audio": "two_triangles_are_congruent_when_one_pair_of_corresponding_sides.mp3"
        }
      ]
    }
  ]
}
